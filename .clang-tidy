# Without this file the IDE runs its own default set, which includes checks that are simply wrong
# for a Qt/KDE program - the disabled ones below each cost more to obey than to ignore.
Checks: >
  bugprone-*,
  cppcoreguidelines-*,
  misc-*,
  modernize-*,
  performance-*,
  readability-*,

  -bugprone-easily-swappable-parameters,
  -bugprone-suspicious-include,
  -cppcoreguidelines-avoid-magic-numbers,
  -cppcoreguidelines-owning-memory,
  -cppcoreguidelines-prefer-member-initializer,
  -cppcoreguidelines-pro-bounds-array-to-pointer-decay,
  -cppcoreguidelines-pro-bounds-pointer-arithmetic,
  -cppcoreguidelines-pro-type-static-cast-downcast,
  -cppcoreguidelines-pro-type-union-access,
  -cppcoreguidelines-pro-type-vararg,
  -misc-include-cleaner,
  -modernize-raw-string-literal,
  -modernize-use-trailing-return-type,
  -performance-enum-size,
  -readability-identifier-length,
  -readability-implicit-bool-conversion,
  -readability-magic-numbers,
  -readability-convert-member-functions-to-static,
  -readability-make-member-function-const,
  -readability-redundant-access-specifiers,
  -readability-trailing-comma,

# The generated sources - moc_*.cpp and the D-Bus adaptor - are not ours to fix, and moc alone
# accounts for more warnings than the whole of src/. The headers kconfig_compiler writes live in
# build/src/, which the first pattern would match as well.
HeaderFilterRegex: 'src/[^/]+\.h$'
ExcludeHeaderFilterRegex: 'build/'

CheckOptions:
  # A struct of public fields with a few helpers (WheelSettings) is a value, not a class with an
  # invariant to guard; the check still applies to anything that mixes public and private members.
  misc-non-private-member-variables-in-classes.IgnoreClassesWithAllMemberVariablesBeingPublic: true
  # QVERIFY and QCOMPARE each expand to an if and a return; counted, every test body is "complex".
  readability-function-cognitive-complexity.IgnoreMacros: true

# Why each of the above is off:
#
#   easily-swappable-parameters        (int *minimum, int *maximum) is the clearest signature there
#                                      is; the check wants a struct for every pair.
#   suspicious-include                 #include "moc_foo.cpp" at the end of the .cpp is the Qt
#                                      idiom, not an accident.
#   owning-memory                      every widget is `new`ed and owned by its parent. The check
#                                      wants gsl::owner on all of it.
#   prefer-member-initializer          the child widgets are built in the constructor body because
#                                      the order they are added to the layout is the order they
#                                      appear in; an initialiser list would scatter that.
#   pro-bounds-*                       C arrays and pointer arithmetic at the ::read() boundary.
#   pro-type-union-access              ff_effect.u is the kernel's own union; there is no other way
#                                      to say which effect it carries.
#   pro-type-vararg                    ioctl() and open() are variadic in the C API, and they are how
#                                      a program talks to an event node.
#   pro-type-static-cast-downcast      this is the qMax/dynamic_cast trap: inside an event filter
#                                      the event->type() check has already proved the type, and the
#                                      check's advice - dynamic_cast - is both slower and *less*
#                                      safe, because its null result is what nobody tests for.
#   include-cleaner                    Qt's umbrella headers (<QDialog> pulling in QString, QList,
#                                      ...) make this fire on nearly every line.
#   raw-string-literal                 the escaped quotes it objects to are inside i18n(), and the
#                                      translation extractor reads plain string literals.
#   enum-size                          two enums with nine values each; the byte is not the point.
#   magic-numbers                      the numbers are window sizes in a constructor.
#   convert-member-functions-to-static the same trap from the other side: a Q_PROPERTY getter or a
#                                      Q_INVOKABLE that reads global state (the settings, the clock)
#                                      uses no member, yet QML calls it on the object and it is part
#                                      of the object's interface - and a QTest slot has to be a member
#                                      to be found at all. A plain helper is made static by hand.
#   make-member-function-const         this is the other trap: a setter that only touches a child
#                                      widget through a pointer *can* be const, and marking it so
#                                      claims setLabelText() does not change the dialog. It does.
#   redundant-access-specifiers        `public Q_SLOTS:` after `public:` is meaningful to moc.
#   trailing-comma                     a trailing comma makes clang-format put every element of a
#                                      braced list on a line of its own, which turns each
#                                      {key, value} pair of a QVariantMap into four lines.
